# DuelZone Server Configuration
NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:3000

# SQLite database path (use :memory: for tests or a file path for persistence)
DATABASE_PATH=./data/duelzone.sqlite

# Authentication & Session Secrets (generate strong random 64-char hex strings in production)
JWT_SECRET=
SESSION_TTL_SECONDS=604800

# Match & Gameplay Configuration
ROOM_TTL_MINUTES=15
MATCH_RECONNECT_GRACE_SECONDS=30
MATCHMAKING_TIMEOUT_SECONDS=90
TTT_TURN_SECONDS=30
RPS_ROUND_SECONDS=20
CONNECT_FOUR_TURN_SECONDS=35
CHAT_MAX_LENGTH=500

# Runtime hosting URL
APP_URL=http://localhost:3000
